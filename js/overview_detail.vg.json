{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "data/domestic_quarterly.csv"},
  "params": [
    {
      "name": "state_select",
      "value": "New South Wales",
      "bind": {
        "input": "select",
        "options": ["New South Wales","Victoria","Queensland","Western Australia","South Australia","Tasmania","Northern Territory","Australian Capital Territory"],
        "name": "Select a state: "
      }
    }
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 210,
      "title": {"text": "Overview — total 2025 overnight trips by state (selected state highlighted)", "font": "Lato", "fontSize": 13, "anchor": "start", "color": "#1a3a4a"},
      "mark": {"type": "bar"},
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {"labelFont": "Lato", "labelFontSize": 12}
        },
        "x": {
          "aggregate": "sum",
          "field": "trips",
          "type": "quantitative",
          "title": "Total overnight trips ('000)",
          "axis": {"labelFont": "Lato", "titleFont": "Lato", "titleFontSize": 11}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["New South Wales","Victoria","Queensland","Western Australia","South Australia","Tasmania","Northern Territory","Australian Capital Territory"],
            "range": ["#1a7a6e","#4a90d9","#e8a838","#7b5ea7","#e06c56","#5da05d","#c96fbf","#aaaaaa"]
          },
          "legend": null
        },
        "opacity": {
          "condition": {"test": "datum.state == state_select", "value": 1},
          "value": 0.3
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"aggregate": "sum", "field": "trips", "type": "quantitative", "title": "Total trips ('000)", "format": ",.0f"}
        ]
      }
    },
    {
      "width": "container",
      "height": 180,
      "title": {"text": "Detail — selected state's visitor spend by quarter ($M)", "font": "Lato", "fontSize": 13, "anchor": "start", "color": "#1a3a4a"},
      "transform": [{"filter": "datum.state == state_select"}],
      "mark": {"type": "bar", "color": "#1a7a6e"},
      "encoding": {
        "x": {
          "field": "quarter",
          "type": "ordinal",
          "sort": ["Mar Q 2025","Jun Q 2025","Sep Q 2025","Dec Q 2025"],
          "title": "Quarter 2025",
          "axis": {"labelFont": "Lato", "titleFont": "Lato", "labelAngle": 0}
        },
        "y": {
          "field": "spend",
          "type": "quantitative",
          "title": "Visitor spend ($M)",
          "axis": {"labelFont": "Lato", "titleFont": "Lato"}
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "quarter", "type": "nominal", "title": "Quarter"},
          {"field": "spend", "type": "quantitative", "title": "Spend ($M)", "format": ",.1f"},
          {"field": "nights", "type": "quantitative", "title": "Visitor nights ('000)", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {"font": "Lato", "view": {"stroke": null}, "axis": {"grid": false}}
}
