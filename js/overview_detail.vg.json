{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "data/domestic_quarterly.csv"},
  "params": [
    {
      "name": "state_select",
      "value": "New South Wales",
      "bind": {
        "input": "select",
        "options": ["New South Wales","Victoria","Queensland","Western Australia","South Australia","Tasmania","Northern Territory","Australian Capital Territory"],
        "name": "Select a state: "
      }
    }
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 220,
      "title": "Selected state — visitor spend by quarter ($M)",
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "quarter",
          "type": "ordinal",
          "sort": ["Mar Q 2025","Jun Q 2025","Sep Q 2025","Dec Q 2025"],
          "title": "Quarter 2025",
          "axis": {"labelFont": "Lato", "titleFont": "Lato", "labelAngle": 0}
        },
        "y": {
          "field": "trips",
          "type": "quantitative",
          "stack": "zero",
          "title": "Overnight trips ('000)",
          "axis": {"labelFont": "Lato", "titleFont": "Lato"}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["New South Wales","Victoria","Queensland","Western Australia","South Australia","Tasmania","Northern Territory","Australian Capital Territory"],
            "range": ["#1a7a6e","#4a90d9","#e8a838","#7b5ea7","#e06c56","#5da05d","#c96fbf","#aaaaaa"]
          },
          "legend": {"title": "State / Territory", "labelFont": "Lato", "titleFont": "Lato"}
        },
        "opacity": {
          "condition": {"test": "datum.state == state_select", "value": 1},
          "value": 0.25
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "quarter", "type": "nominal", "title": "Quarter"},
          {"field": "trips", "type": "quantitative", "title": "Trips ('000)", "format": ",.1f"}
        ]
      }
    },
    {
      "width": "container",
      "height": 160,
      "title": "Selected state — visitor nights by quarter",
      "transform": [{"filter": "datum.state == state_select"}],
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "quarter",
          "type": "ordinal",
          "sort": ["Mar Q 2025","Jun Q 2025","Sep Q 2025","Dec Q 2025"],
          "title": "Quarter 2025",
          "axis": {"labelFont": "Lato", "titleFont": "Lato", "labelAngle": 0}
        },
        "y": {
          "field": "spend",
          "type": "quantitative",
          "title": "Visitor nights ($M)",
          "axis": {"labelFont": "Lato", "titleFont": "Lato"}
        },
        "color": {"value": "#1a7a6e"},
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "quarter", "type": "nominal", "title": "Quarter"},
          {"field": "spend", "type": "quantitative", "title": "Spend ($M)", "format": ",.1f"},
          {"field": "night", "type": "quantitative", "title": "Visitor nights ('000)", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {"font": "Lato", "view": {"stroke": null}, "axis": {"grid": false}}
}
