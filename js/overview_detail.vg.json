{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "data/domestic_quarterly.csv"},
  "vconcat": [
    {
      "width": "container",
      "height": 220,
      "title": "Click a state in the legend to isolate its pattern",
      "mark": "bar",
      "params": [
        {
          "name": "state_highlight",
          "value": [{"state": "New South Wales"}],
          "select": {"type": "point", "fields": ["state"]},
          "bind": "legend"
        }
      ],
      "encoding": {
        "x": {
          "field": "quarter",
          "type": "ordinal",
          "sort": ["Mar Q 2025","Jun Q 2025","Sep Q 2025","Dec Q 2025"],
          "title": "Quarter 2025",
          "axis": {"labelFont": "Lato", "titleFont": "Lato", "labelAngle": 0}
        },
        "y": {
          "field": "trips",
          "type": "quantitative",
          "stack": "zero",
          "title": "Overnight trips ('000)",
          "axis": {"labelFont": "Lato", "titleFont": "Lato"}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["New South Wales","Victoria","Queensland","Western Australia","South Australia","Tasmania","Northern Territory","Australian Capital Territory"],
            "range": ["#1a7a6e","#4a90d9","#e8a838","#7b5ea7","#e06c56","#5da05d","#c96fbf","#aaaaaa"]
          },
          "legend": {"title": "State / Territory", "labelFont": "Lato", "titleFont": "Lato"}
        },
        "opacity": {
          "condition": {"param": "state_highlight", "value": 1},
          "value": 0.15
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "quarter", "type": "nominal", "title": "Quarter"},
          {"field": "trips", "type": "quantitative", "title": "Trips ('000)", "format": ",.1f"}
        ]
      }
    },
    {
      "width": "container",
      "height": 160,
      "title": "Selected state — visitor nights and spend by quarter",
      "transform": [{"filter": {"param": "state_highlight"}}],
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "quarter",
          "type": "ordinal",
          "sort": ["Mar Q 2025","Jun Q 2025","Sep Q 2025","Dec Q 2025"],
          "title": "Quarter 2025",
          "axis": {"labelFont": "Lato", "titleFont": "Lato", "labelAngle": 0}
        },
        "y": {
          "field": "nights",
          "type": "quantitative",
          "title": "Visitor nights ('000)",
          "axis": {"labelFont": "Lato", "titleFont": "Lato"}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["New South Wales","Victoria","Queensland","Western Australia","South Australia","Tasmania","Northern Territory","Australian Capital Territory"],
            "range": ["#1a7a6e","#4a90d9","#e8a838","#7b5ea7","#e06c56","#5da05d","#c96fbf","#aaaaaa"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "quarter", "type": "nominal", "title": "Quarter"},
          {"field": "nights", "type": "quantitative", "title": "Visitor nights ('000)", "format": ",.1f"},
          {"field": "spend", "type": "quantitative", "title": "Spend ($M)", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {"font": "Lato", "view": {"stroke": null}, "axis": {"grid": false}}
}
