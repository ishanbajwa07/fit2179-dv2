{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {"url": "data/state_annual_2025.csv"},
  "encoding": {
    "x": {
      "field": "dom_nights_2025",
      "type": "quantitative",
      "title": "Domestic visitor nights ('000)",
      "axis": {"labelFont": "Lato", "titleFont": "Lato", "titleFontSize": 11}
    },
    "y": {
      "field": "dom_spend_2025",
      "type": "quantitative",
      "title": "Domestic visitor spend ($M)",
      "axis": {"labelFont": "Lato", "titleFont": "Lato", "titleFontSize": 11}
    }
  },
  "layer": [
    {
      "mark": {"type": "circle", "opacity": 0.7},
      "encoding": {
        "size": {
          "field": "int_trips_2025",
          "type": "quantitative",
          "scale": {"range": [150, 2500]},
          "legend": {"title": "Intl. visitors ('000)", "labelFont": "Lato", "titleFont": "Lato"}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["New South Wales","Victoria","Queensland","Western Australia","South Australia","Tasmania","Northern Territory","Australian Capital Territory"],
            "range": ["#1a7a6e","#4a90d9","#e8a838","#7b5ea7","#e06c56","#5da05d","#c96fbf","#aaaaaa"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "dom_nights_2025", "type": "quantitative", "title": "Dom. nights ('000)", "format": ",.1f"},
          {"field": "dom_spend_2025", "type": "quantitative", "title": "Dom. spend ($M)", "format": ",.1f"},
          {"field": "int_trips_2025", "type": "quantitative", "title": "Intl. visitors ('000)", "format": ",.1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "right", "baseline": "middle", "dx": -12, "fontSize": 11, "fontStyle": "italic"},
      "encoding": {
        "text": {"field": "state", "type": "nominal"},
        "color": {"value": "black"},
        "opacity": {
          "condition": {
            "test": "datum.state == 'New South Wales' || datum.state == 'Victoria' || datum.state == 'Queensland' || datum.state == 'Western Australia' || datum.state == 'South Australia' || datum.state == 'Tasmania'",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ],
  "config": {"font": "Lato", "view": {"stroke": null}, "axis": {"grid": false}}
}
