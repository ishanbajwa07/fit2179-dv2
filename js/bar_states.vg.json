{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "data": {"url": "data/state_annual_2025.csv"},
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {"labelFont": "Lato", "labelFontSize": 12}
    },
    "x": {
      "field": "dom_nights_2025",
      "type": "quantitative",
      "title": "Domestic visitor nights ('000)",
      "axis": {"labelFont": "Lato", "titleFont": "Lato", "titleFontSize": 11}
    },
    "color": {
      "field": "dom_nights_2025",
      "type": "quantitative",
      "scale": {"scheme": "tealblues"},
      "legend": null
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "dom_nights_2025", "type": "quantitative", "title": "Visitor nights ('000)", "format": ",.1f"},
      {"field": "dom_spend_2025", "type": "quantitative", "title": "Dom. spend ($M)", "format": ",.1f"},
      {"field": "int_trips_2025", "type": "quantitative", "title": "Intl. visitors ('000)", "format": ",.1f"}
    ]
  },
  "config": {
    "font": "Lato",
    "view": {"stroke": null},
    "axis": {"grid": false}
  }
}
