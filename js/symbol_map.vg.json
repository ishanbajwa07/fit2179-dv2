{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "#dde5e8", "stroke": "white", "strokeWidth": 0.5}
    },
    {
      "data": {"url": "data/international_by_country.csv"},
      "mark": {"type": "circle", "opacity": 0.75},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "trips_2025",
          "type": "quantitative",
          "scale": {"range": [80, 4000]},
          "legend": {"title": "Visitors ('000)", "labelFont": "Lato", "titleFont": "Lato"}
        },
        "color": {
          "field": "spend_2025",
          "type": "quantitative",
          "scale": {"scheme": "oranges"},
          "legend": {"title": "Spend in Aus ($M)", "labelFont": "Lato", "titleFont": "Lato", "gradientLength": 100}
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "trips_2025", "type": "quantitative", "title": "Visitors 2025 ('000)", "format": ",.1f"},
          {"field": "trips_2024", "type": "quantitative", "title": "Visitors 2024 ('000)", "format": ",.1f"},
          {"field": "spend_2025", "type": "quantitative", "title": "Spend in Aus ($M)", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {"font": "Lato", "view": {"stroke": null}}
}
