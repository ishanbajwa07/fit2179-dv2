{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {"url": "data/domestic_quarterly.csv"},
  "encoding": {
    "x": {
      "field": "quarter",
      "type": "ordinal",
      "sort": ["Mar Q 2025","Jun Q 2025","Sep Q 2025","Dec Q 2025"],
      "title": "Quarter (2025)",
      "axis": {"labelFont": "Lato", "titleFont": "Lato", "labelAngle": 0, "titleFontSize": 12}
    }
  },
  "layer": [
    {
      "mark": {"type": "area"},
      "encoding": {
        "y": {
          "field": "trips",
          "type": "quantitative",
          "stack": "zero",
          "title": "Domestic overnight trips ('000)",
          "axis": {"labelFont": "Lato", "titleFont": "Lato", "titleFontSize": 12}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["New South Wales","Victoria","Queensland","Western Australia","South Australia","Tasmania","Northern Territory","Australian Capital Territory"],
            "range": ["#1a7a6e","#4a90d9","#e8a838","#7b5ea7","#e06c56","#5da05d","#c96fbf","#aaaaaa"]
          },
          "legend": {"title": "State / Territory", "labelFont": "Lato", "titleFont": "Lato", "orient": "right"}
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "quarter", "type": "nominal", "title": "Quarter"},
          {"field": "trips", "type": "quantitative", "title": "Trips ('000)", "format": ",.1f"},
          {"field": "nights", "type": "quantitative", "title": "Visitor nights ('000)", "format": ",.1f"},
          {"field": "spend", "type": "quantitative", "title": "Spend ($M)", "format": ",.1f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.quarter == 'Dec Q 2025' || datum.quarter == 'Sep Q 2025'"}
      ],
      "mark": {"type": "text", "dy": -14, "fontSize": 11, "fontStyle": "italic"},
      "encoding": {
        "y": {
          "field": "trips",
          "type": "quantitative",
          "aggregate": "sum"
        },
        "text": {
          "condition": {"test": "datum.quarter == 'Dec Q 2025'", "value": "▲ Summer peak: 31.6M trips"},
          "value": "▼ Winter trough: 28.8M trips"
        },
        "color": {"value": "#1a3a4a"}
      }
    }
  ],
  "config": {"font": "Lato", "view": {"stroke": null}, "axis": {"grid": false}}
}
