{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {"url": "data/international_by_country.csv"},
  "transform": [
    {"filter": "datum.country != 'Thailand' && datum.country != 'Vietnam' && datum.country != 'Philippines' && datum.country != 'Taiwan' && datum.country != 'Canada' && datum.country != 'Germany' && datum.country != 'France' && datum.country != 'Malaysia'"},
    {"calculate": "round((datum.trips_2025 - datum.trips_2024) / datum.trips_2024 * 1000) / 10", "as": "growth_pct"},
    {"calculate": "(datum.growth_pct > 0 ? '+' : '') + datum.growth_pct + '%'", "as": "growth_label"}
  ],
  "layer": [
    {
      "mark": {"type": "bar", "height": 18, "color": "#cfd8dc"},
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-trips_2025",
          "title": null,
          "axis": {"labelFont": "Lato", "labelFontSize": 12}
        },
        "x": {
          "field": "trips_2024",
          "type": "quantitative",
          "title": "Visitors ('000)",
          "axis": {"labelFont": "Lato", "titleFont": "Lato"}
        }
      }
    },
    {
      "mark": {"type": "bar", "height": 9, "color": "#1a7a6e"},
      "encoding": {
        "y": {"field": "country", "type": "nominal", "sort": "-trips_2025"},
        "x": {"field": "trips_2025", "type": "quantitative"},
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "trips_2024", "type": "quantitative", "title": "2024 visitors ('000)", "format": ",.1f"},
          {"field": "trips_2025", "type": "quantitative", "title": "2025 visitors ('000)", "format": ",.1f"},
          {"field": "growth_label", "type": "nominal", "title": "Growth 2024→2025"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 5, "fontSize": 10, "fontStyle": "italic"},
      "encoding": {
        "y": {"field": "country", "type": "nominal", "sort": "-trips_2025"},
        "x": {"field": "trips_2025", "type": "quantitative"},
        "text": {"field": "growth_label", "type": "nominal"},
        "color": {
          "condition": {"test": "datum.growth_pct > 0", "value": "#1a7a6e"},
          "value": "#e06c56"
        }
      }
    }
  ],
  "config": {"font": "Lato", "view": {"stroke": null}, "axis": {"grid": false}}
}
