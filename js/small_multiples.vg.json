{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "data/domestic_quarterly.csv"},

  "title": {
    "text": "Domestic Overnight Trips by Quarter — All States (2025)",
    "anchor": "start",
    "font": "Lato",
    "fontSize": 20,
    "fontWeight": "bold",
    "color": "#1a3a4a",
    "offset": 20
  },

  "resolve": {"scale": {"y": "independent"}},

  "facet": {
    "field": "state",
    "type": "nominal",
    "title": null,
    "columns": 4,
    "sort": [
      "New South Wales",
      "Victoria",
      "Queensland",
      "Western Australia",
      "South Australia",
      "Tasmania",
      "Northern Territory",
      "Australian Capital Territory"
    ],
    "header": {
      "labelFont": "Lato",
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelColor": "#1a3a4a",
      "labelLimit": 260,
      "labelPadding": 12
    }
  },

  "spec": {
    "width": 210,
    "height": 210,

    "mark": {
      "type": "bar",
      "color": "#2f8f83",
      "opacity": 0.9,
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    },

    "encoding": {
      "x": {
        "field": "quarter",
        "type": "ordinal",
        "sort": ["Mar Q 2025", "Jun Q 2025", "Sep Q 2025", "Dec Q 2025"],
        "title": null,
        "axis": {
          "labelAngle": 0,
          "labelFontSize": 9,
          "labelFont": "Lato",
          "labelLineHeight": 11,
          "labelExpr": "replace(datum.label, ' Q 2025', '\\nQ 2025')",
          "labelPadding": 6,
          "ticks": false,
          "domain": false
        }
      },

      "y": {
        "field": "trips",
        "type": "quantitative",
        "title": "Trips ('000)",
        "axis": {
          "labelFontSize": 9,
          "titleFontSize": 10,
          "labelFont": "Lato",
          "titleFont": "Lato",
          "tickCount": 4,
          "grid": true,
          "gridOpacity": 0.25,
          "domain": false,
          "ticks": false
        }
      },

      "tooltip": [
        {"field": "state", "type": "nominal", "title": "State"},
        {"field": "quarter", "type": "nominal", "title": "Quarter"},
        {"field": "trips", "type": "quantitative", "title": "Trips ('000)", "format": ",.1f"}
      ]
    }
  },

  "spacing": {
    "row": 45,
    "column": 35
  },

  "config": {
    "font": "Lato",
    "background": "white",
    "view": {
      "stroke": "#d8e8e5"
    },
    "axis": {
      "labelColor": "#263238",
      "titleColor": "#263238"
    }
  }
}
