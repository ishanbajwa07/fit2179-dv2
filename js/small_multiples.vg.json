{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "data/domestic_quarterly.csv"},
  "resolve": {"scale": {"y": "independent"}},
  "facet": {
    "field": "state",
    "type": "nominal",
    "title": null,
    "sort": ["New South Wales","Victoria","Queensland","Western Australia","South Australia","Tasmania","Northern Territory","Australian Capital Territory"],
    "columns": 4,
    "header": {
      "labelFont": "Lato",
      "labelFontSize": 11,
      "labelFontWeight": "bold",
      "labelColor": "#1a3a4a",
      "labelLimit": 250
    }
  },
  "spec": {
    "width": 220,
    "height": 250,
    "mark": {"type": "bar", "color": "#1a7a6e", "opacity": 0.85},
    "encoding": {
      "x": {
        "field": "quarter",
        "type": "ordinal",
        "sort": ["Mar Q 2025","Jun Q 2025","Sep Q 2025","Dec Q 2025"],
        "title": null,
        "axis": {
          "labelAngle": 0,
          "labelFontSize": 8,
          "labelFont": "Lato",
          "labelLineHeight": 12,
          "labelExpr": "replace(datum.label, ' 2025', '\\n2025')"
        }
      },
      "y": {
        "field": "trips",
        "type": "quantitative",
        "title": "Trips ('000)",
        "axis": {
          "labelFontSize": 8,
          "titleFontSize": 9,
          "labelFont": "Lato",
          "titleFont": "Lato",
          "tickCount": 5
        }
      },
      "tooltip": [
        {"field": "state", "type": "nominal", "title": "State"},
        {"field": "quarter", "type": "nominal", "title": "Quarter"},
        {"field": "trips", "type": "quantitative", "title": "Trips ('000)", "format": ",.1f"}
      ]
    }
  },
  "config": {
    "font": "Lato",
    "view": {"stroke": "#d0e4e1"},
    "facet": {"spacing": 20},
    "axis": {"grid": false}
  }
}
